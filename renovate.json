{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "maintenance"
  ],
  "dependencyDashboard": true,
  "enabledManagers": [
    "kubernetes",
    "argocd",
    "custom.regex"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^manifests/apps/.*\\.yaml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/manifests/argoapps/.+\\.yaml$/"
    ]
  },
  "recreateWhen": "always",
  "rebaseWhen": "conflicted",
  "prHourlyLimit": 0,
  "branchConcurrentLimit": 0,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true,
      "ignoreTests": true,
      "description": "Automerge all non-major updates"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "description": "Major updates always need a manual merge"
    },
    {
      "matchPackageNames": [
        "nextcloud"
      ],
      "matchFileNames": [
        "manifests/argoapps/talos/nextcloud.yaml"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true,
      "description": "Pin nextcloud image digest"
    },
    {
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "matchFileNames": [
        "manifests/argoapps/talos/immich.yaml"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "groupName": "immich",
      "pinDigests": true,
      "description": "Keep immich server and machine-learning on the same version in one PR"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/talhelper/talconfig\\.yaml/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+)\\n\\w+Version: (?<currentValue>v[\\d\\.]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/manifests/apps/talos/tuppr/.+\\.yaml/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+)\\n\\s+version: (?<currentValue>v[\\d\\.]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/manifests/argoapps/talos/nextcloud.yaml/"
      ],
      "matchStrings": [
        "tag:\\s*\"?(?<currentValue>[\\d\\.]+-fpm)(@(?<currentDigest>sha256:[a-f0-9]{64}))?\"?"
      ],
      "depNameTemplate": "nextcloud",
      "datasourceTemplate": "docker",
      "packageNameTemplate": "nextcloud"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/manifests/argoapps/talos/immich.yaml/"
      ],
      "matchStrings": [
        "# renovate: image=(?<depName>\\S+)\\n\\s+tag:\\s*\"?(?<currentValue>v\\d+\\.\\d+\\.\\d+)(@(?<currentDigest>sha256:[a-f0-9]{64}))?\"?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Upstream manifests referenced by URL in kustomizations",
      "managerFilePatterns": [
        "/(^|/)kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/(?<currentValue>v[^/\\s]+)/",
        "https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/(?<currentValue>v[^/\\s]+)/"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
